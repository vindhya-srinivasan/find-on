# Copy to .env.local and fill in. NEVER commit .env files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only
ANTHROPIC_API_KEY=              # server only
# ANTHROPIC_MODEL=claude-sonnet-5-5   # optional override
NEXT_PUBLIC_USE_MOCKS=true      # Person 1: true until real API routes are live
NEXT_PUBLIC_REQUIRE_SIGNIN=false # true = everyone must sign in before using the app
NEXT_PUBLIC_REAL_AUTH=false     # true = real Supabase email sign-in while data stays sample
